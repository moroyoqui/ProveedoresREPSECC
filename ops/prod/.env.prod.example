# =============================================================================
# ProveedoresREPSECC — variables de producción
# Copiar en el servidor como /opt/repse/.env (chmod 600, dueño deploy).
# Este archivo NO se versiona con valores reales.
# =============================================================================

# -----------------------------------------------------------------------------
# Imágenes (las sobreescribe deploy.sh en cada despliegue con el SHA del commit)
# -----------------------------------------------------------------------------
APP_IMAGE=ghcr.io/moroyoqui/proveedoresrepsecc/app:latest
WEB_IMAGE=ghcr.io/moroyoqui/proveedoresrepsecc/web:latest

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=prod
APP_SECRET=                        # openssl rand -hex 32
APP_BASE_URL=https://repse.ejemplo.com
UPLOAD_ROOT=/var/repse/uploads
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=repse
DB_USER=repse
DB_PASS=

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=repse
MYSQL_USER=repse
MYSQL_PASSWORD=                    # debe coincidir con DB_PASS

# -----------------------------------------------------------------------------
# OAuth / OIDC — los redirect URIs deben apuntar al dominio de producción
# -----------------------------------------------------------------------------
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
OIDC_MICROSOFT_TENANT=common

# -----------------------------------------------------------------------------
# OCR
# -----------------------------------------------------------------------------
TESSERACT_LANG=spa+eng

# -----------------------------------------------------------------------------
# Observabilidad
# -----------------------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# -----------------------------------------------------------------------------
# Alertas / SMTP real (nada de mailpit en producción)
# -----------------------------------------------------------------------------
ALERTS_SCHEDULER_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=alertas@ejemplo.com
SMTP_FROM_NAME=REPSE Compliance
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=30

# Con BREVO_API_KEY definida, el envío va por la API transaccional de Brevo y
# se ignoran SMTP_HOST/USERNAME/PASSWORD. El remitente y el timeout se siguen
# tomando de las variables SMTP_* de arriba.
BREVO_API_KEY=

# -----------------------------------------------------------------------------
# Caddy — dominio público real; ACME emite el certificado automáticamente.
# -----------------------------------------------------------------------------
CADDY_DOMAIN=repse.ejemplo.com

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_DIR=/opt/repse/backups
BACKUP_RETENTION_DAYS=14
