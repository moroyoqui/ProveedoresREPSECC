# Caddy reverse proxy + TLS automático.
# En local: `tls internal` genera cert autofirmado confiable.
# En prod: cambiar CADDY_DOMAIN a tu dominio público; Caddy obtiene cert ACME automáticamente.

# HTTP -> HTTPS redirect. El docker-compose mapea host:8080 -> container:80
# y host:8443 -> container:443; el redirect default de Caddy no conoce los
# puertos del host, por eso lo escribimos explícitamente.
http://{$CADDY_DOMAIN} {
    redir https://{$CADDY_DOMAIN}:8443{uri} permanent
}

https://{$CADDY_DOMAIN} {
    tls internal

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    @api path /api/* /docs /openapi.json /metrics /health
    reverse_proxy @api app:8000

    reverse_proxy frontend:5173

    log {
        output stdout
        format json
    }
}
