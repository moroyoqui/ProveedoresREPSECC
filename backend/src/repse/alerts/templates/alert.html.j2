<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ subject }}</title>
  </head>
  <body style="margin:0;padding:0;background:#F3F4F6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F3F4F6;padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">
            <tr>
              <td style="background:#0B2545;padding:20px 24px;color:#ffffff;font-size:18px;font-weight:bold;">
                Cumplimiento REPSE
              </td>
            </tr>
            <tr>
              <td style="padding:24px;">
                <h1 style="font-size:18px;margin:0 0 8px;color:#0B2545;">{{ subject }}</h1>
                <p style="font-size:14px;line-height:1.5;margin:0 0 16px;">
                  {% if alert_type == "expired" %}
                  Los siguientes documentos del proveedor <strong>{{ supplier_name }}</strong> están <strong style="color:#b91c1c;">vencidos</strong>:
                  {% else %}
                  Los siguientes documentos del proveedor <strong>{{ supplier_name }}</strong> están <strong style="color:#b45309;">por vencer</strong>:
                  {% endif %}
                </p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
                  <tr style="background:#F3F4F6;">
                    <th align="left" style="padding:8px;border-bottom:1px solid #e5e7eb;">Documento</th>
                    <th align="left" style="padding:8px;border-bottom:1px solid #e5e7eb;">Periodo</th>
                    <th align="left" style="padding:8px;border-bottom:1px solid #e5e7eb;">Vence</th>
                  </tr>
                  {% for d in documents %}
                  <tr>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;">{{ d.type_name }}</td>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;">{{ d.period or "—" }}</td>
                    <td style="padding:8px;border-bottom:1px solid #f3f4f6;">
                      {{ d.due_date or "—" }}{% if d.days_until_due is not none %} ({{ d.days_until_due }} días){% endif %}
                    </td>
                  </tr>
                  {% endfor %}
                </table>
                {% if documents and documents[0].link %}
                <p style="margin:24px 0 0;">
                  <a href="{{ documents[0].link }}" style="display:inline-block;background:#0B2545;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-size:14px;">Ver detalle</a>
                </p>
                {% endif %}
              </td>
            </tr>
            <tr>
              <td style="padding:16px 24px;background:#F3F4F6;font-size:12px;color:#6b7280;">
                Esta es una notificación operativa automática. El acceso al detalle requiere iniciar sesión.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
